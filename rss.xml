---
layout: null
permalink: /rss.xml
sitemap: false
---
{%- assign ko_desc = "퇴근 후 혼자 앱을 만들어 출시하며 배운 것들의 기록. 타로 카드 78장 의미 사전, 아이들을 위해 만든 학습 앱, 그리고 앱 운영·플랫폼 정책 정리." -%}
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.title | xml_escape }}</title>
    <link>{{ '/ko/' | absolute_url }}</link>
    <description>{{ ko_desc | xml_escape }}</description>
    <language>ko</language>
    <generator>Jekyll</generator>
    <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
    <atom:link href="{{ '/rss.xml' | absolute_url }}" rel="self" type="application/rss+xml" />
    {%- for post in site.posts limit: 30 %}
    <item>
      <title>{{ post.title | xml_escape }}</title>
      <link>{{ post.url | absolute_url }}</link>
      <guid isPermaLink="true">{{ post.url | absolute_url }}</guid>
      <pubDate>{{ post.date | date_to_rfc822 }}</pubDate>
      <description>{{ post.description | default: post.excerpt | strip_html | normalize_whitespace | truncate: 300 | xml_escape }}</description>
      {%- for tag in post.tags %}
      <category>{{ tag | xml_escape }}</category>
      {%- endfor %}
    </item>
    {%- endfor %}
  </channel>
</rss>
